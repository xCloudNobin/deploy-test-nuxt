# Nuxt taskboard runtime configuration.
# Copy to .env for local development, or export in the platform environment
# for production. None of these values are secrets.
#
# NOTE: Nuxt does not read .env in the compiled production server; set these
# variables in the real environment (shell / platform) when running
# `node .output/server/index.mjs`.

# Server bind address and port (Nitro's node-server reads these directly).
HOST=0.0.0.0
PORT=3000

# Persistence. DATA_DIR/DATABASE_PATH point at the persistent SQLite file.
# Keep this path on a persistent volume; the app never stores permanent data
# in an ephemeral release directory.
DATA_DIR=./data
DATABASE_PATH=./data/taskboard.db

# Non-sensitive release marker shown in the UI footer via /api/meta.
# scripts/build.sh writes VERSION (git SHA by default) into the build.
BUILD_MARKER=develop